+
+--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
++++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
+@@ -270,6 +270,7 @@
+ #define   RTL8365MB_SDS_INDACS_CMD_BUSY_MASK	0x0100
+ #define   RTL8365MB_SDS_INDACS_CMD_RUN_MASK	0x0080
